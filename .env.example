# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git; never commit real keys.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key only. Never put a service_role/secret key here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Set to exactly 'true' to show messaging (Prototype 9 feature).
EXPO_PUBLIC_MESSAGING_ENABLED=false
